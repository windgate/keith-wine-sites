---
interface Props {
  id?: string;
  heading: string;
  personName?: string | null;
  personTitle?: string | null;
  photo?: string | null;
  /** Small caption shown under the photo. */
  photoCaption?: string | null;
  /** Optional image shown behind the whole section. */
  background?: string | null;
  body?: string | null;
}

const { id = 'about', heading, personName, personTitle, photo, photoCaption, background, body } =
  Astro.props;
const paragraphs = (body ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<section
  class:list={['section', { 'has-bg': Boolean(background) }]}
  id={id}
  style={background ? `--section-bg:url('${background}')` : undefined}
>
  <div class="wrap">
    <h2>{heading}</h2>
    <div class:list={['about-layout', { 'has-photo': Boolean(photo) }]}>
      {
        photo && (
          <figure class="about-figure">
            <img src={photo} alt={photoCaption ?? personName ?? heading} />
            {photoCaption && <figcaption>{photoCaption}</figcaption>}
            {(personName || personTitle) && (
              <p class="person">
                {personName}
                {personName && personTitle && ' / '}
                {personTitle}
              </p>
            )}
          </figure>
        )
      }
      <div>
        {!photo && (personName || personTitle) && (
          <p class="person">
            {personName}
            {personName && personTitle && ' / '}
            {personTitle}
          </p>
        )}
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
