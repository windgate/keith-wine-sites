---
import { office } from '../site-defaults';

interface Person {
  name: string;
  title?: string | null;
  cell?: string | null;
  email?: string | null;
}

interface Props {
  id?: string;
  heading: string;
  intro?: string | null;
  formHeading?: string | null;
  people?: Person[];
  showEmail?: boolean;
  quote?: string | null;
  quoteAuthor?: string | null;
  /** Netlify form name. Keep it different on each site. */
  formName: string;
}

const {
  id = 'contact',
  heading,
  intro,
  formHeading,
  people = [],
  showEmail = true,
  quote,
  quoteAuthor,
  formName,
} = Astro.props;

// Phone numbers and email addresses are stored scrambled (base64) in the page
// and put together by a small script in the visitor's browser. Simple bots
// that only read the page's HTML never see them.
const enc = (value: string) => Buffer.from(value, 'utf8').toString('base64');
const telHref = (value: string) => `tel:+${value.replace(/\D/g, '')}`;
---

<section class="section" id={id}>
  <div class="wrap">
    <h2>{heading}</h2>
    {intro && <p class="intro">{intro}</p>}
    <div class="contact-layout">
      <div>
        {
          people.length > 0 && (
            <ul class="people">
              {people.map((p) => (
                <li>
                  <strong>{p.name}</strong>
                  {p.title && <span> / {p.title}</span>}
                  {p.cell && (
                    <div
                      data-protect="tel"
                      data-label="Cellular"
                      data-v={enc(p.cell)}
                      data-h={enc(telHref(p.cell))}
                    />
                  )}
                  {p.email && <div data-protect="mail" data-v={enc(p.email)} />}
                </li>
              ))}
            </ul>
          )
        }
        <address>
          {office.addressLines.map((line) => <div>{line}</div>)}
        </address>
        <p
          data-protect="tel"
          data-label="Office"
          data-v={enc(office.phoneDisplay)}
          data-h={enc(office.phoneHref)}
        >
        </p>
        {showEmail && <p data-protect="mail" data-v={enc(office.email)} />}
        <noscript><p>Please use the contact form to reach us.</p></noscript>
        {
          quote && (
            <blockquote class="pullquote" style="text-align:left;margin-left:0">
              <p>{quote}</p>
              {quoteAuthor && <cite>{quoteAuthor}</cite>}
            </blockquote>
          )
        }
      </div>
      <div>
        {formHeading && <h3>{formHeading}</h3>}
        <form
          class="contact-form"
          name={formName}
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-contact-form
        >
          <input type="hidden" name="form-name" value={formName} />
          <p class="hp" aria-hidden="true">
            <label>Do not fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <label>
            Name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Message
            <textarea name="message" rows="6" required></textarea>
          </label>
          <button type="submit">Send message</button>
          <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Put the phone numbers and email addresses together (see the note above).
  document.querySelectorAll<HTMLElement>('[data-protect]').forEach((el) => {
    const text = atob(el.dataset.v ?? '');
    if (!text) return;
    const link = document.createElement('a');
    link.textContent = text;
    link.href = el.dataset.protect === 'mail' ? `mailto:${text}` : atob(el.dataset.h ?? '');
    el.textContent = el.dataset.label ? `${el.dataset.label} ` : '';
    el.append(link);
  });
</script>

<script>
  // Send the form in the background so the visitor stays on the page. If this
  // fails, the browser falls back to a normal form post that Netlify handles.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (status) status.textContent = 'Sending...';
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      if (status) status.textContent = 'Thank you. Your message has been sent.';
    } catch {
      if (status) status.textContent = 'Sorry, that did not go through. Please try again or call the office.';
    }
  });
</script>
