---
interface Props {
  heading: string;
  tagline?: string | null;
  image?: string | null;
  imageCaption?: string | null;
  /** Where the title sits: centered (default) or at the left, clear of a subject in the middle of the photo. */
  textAlign?: 'center' | 'left' | null;
}

const { heading, tagline, image, imageCaption, textAlign } = Astro.props;
// A new line in the heading is shown as a line break.
const headingLines = heading.split(/\r?\n/);
---

<section class:list={['hero', { 'hero-left': textAlign === 'left' }]} id="top">
  <figure>
    {image && <img class="hero-image" src={image} alt="" />}
    <div class="wrap">
      <h1>
        {headingLines.map((line, i) => (i === 0 ? line : [<br />, line]))}
      </h1>
      {tagline && <p>{tagline}</p>}
    </div>
    {imageCaption && <figcaption>{imageCaption}</figcaption>}
  </figure>
</section>
