---
import type { NavLink } from '../site-defaults';

interface Props {
  brandName: string;
  logo?: string | null;
  links: NavLink[];
}

const { brandName, logo, links } = Astro.props;
---

<header class="site-nav">
  <div class="wrap">
    <a class="brand" href="/">
      {
        logo ? (
          <img src={logo} alt={brandName} height="44" />
        ) : (
          <span>{brandName}</span>
        )
      }
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // The nav is taller on phones, where its links wrap. Measure it so the hero
  // can fill exactly the rest of the screen, and anchor links stop below it.
  const nav = document.querySelector<HTMLElement>('.site-nav');
  if (nav) {
    const setHeight = () =>
      document.documentElement.style.setProperty('--nav-h', `${nav.offsetHeight}px`);
    setHeight();
    new ResizeObserver(setHeight).observe(nav);
  }
</script>
